# ---- Auth.js (NextAuth v5) ----
# Required: shared secret used to encrypt session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=v8QuTFEoNmbob12sDFwgB41WBOxLNC0swklRECCfU8E

# Local tool running on localhost / LAN — trust the host header.
AUTH_TRUST_HOST=true

# ---- OpenRouter (optional, server-side fallback) ----
# Lets /api/chat and /api/models use OpenRouter out of the box when no key is
# stored in the app's Settings (browser localStorage). Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# ---- Gemini (optional, server-side fallback) ----
# Same fallback for the Gemini provider (chat + image analysis + live model list).
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# ---- Puter (optional: free AI, 1000+ models) ----
# Free AI with a monthly allowance via puter.com — Gemini chat, Nano Banana
# image generation, GPT Image 2, Grok, Llama and 1000+ models.
# One-time mint:  npm run puter-token   (opens your browser, sign in on puter.com)
# PUTER_AUTH_TOKEN=

# ---- OAuth providers (optional) ----
# Google: create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3100/api/auth/callback/google (and :3001 for dev)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# GitHub: create an OAuth app at https://github.com/settings/developers
# Homepage URL: http://localhost:3100   Callback URL: http://localhost:3100/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# ---- Splitting the deployment (Vercel frontend + Render backend) ----
# The frontend (this Next.js app) is plain Vercel. The YouTube tools backend
# lives in backend/ (Python Flask + yt-dlp with ffmpeg, deploys to Render).
#
# Frontend / Vercel env:
#   NEXT_PUBLIC_YT_API_URL=https://ai-toolbox-youtube-api.onrender.com
#   - When set, the YouTube tools call the Render backend. Leave unset for
#     local dev (falls back to the same-origin /api/tools/youtube/* routes).
#   AUTH_SECRET          (required for auth; generate with node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
#   AUTH_TRUST_HOST=true
#   XKIRO_API_KEY / OPENROUTER_API_KEY / GEMINI_API_KEY / PUTER_AUTH_TOKEN (optional server-side fallbacks)
#   AUTH_GOOGLE_ID / SECRET, AUTH_GITHUB_ID / SECRET (optional OAuth)
#
# Backend / Render env:
#   PORT                (set automatically by Render)
#   No API keys needed — the backend only scrapes YouTube and runs yt-dlp.
#
# Notes:
#   .data/ (chat history, user accounts) lives on the server disk and is
#   ephemeral on Render free instances — it resets on redeploy. For the
#   Vercel frontend, history is served by the app itself (Vercel serverless
#   functions have an ephemeral filesystem too) — use a database for a
#   public, durable deployment.
#   Tavily (web search) stays a per-user key in Settings; there is no env var.